{
  "name": "bb-plugin-workbench-sidebar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bb's sidebar thread list: pinned threads, custom sections, projects, machines, and nested threads.",
  "engines": {
    "bb": ">=0.48.1 <0.49",
    "bbPluginSdk": ">=0.6.104 <0.7"
  },
  "bb": {
    "name": "Workbench sidebar",
    "description": "A full fork of bb\u2019s thread list with provider activity rings and Boat work trees.",
    "branding": {
      "icon": "ListView"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "build": "bb plugin build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-compose-refs": "^1.1.3",
    "@radix-ui/react-slot": "^1.3.0",
    "jotai": "^2.19.0",
    "zod": "^4.3.6",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-tooltip": "^1.2.12"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "jsdom": "^26.1.0",
    "oxlint": "^1.79.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "license": "MIT"
}
