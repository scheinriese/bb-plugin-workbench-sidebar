{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./vendor/shared-ui/*"
      ]
    }
  },
  "include": [
    "server.ts",
    "server.test.ts",
    "app.tsx",
    "app.test.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "shared/**/*.ts",
    "vitest.config.ts",
    "vendor/**/*.ts",
    "vendor/**/*.tsx",
    "sidebarRowRenders.test.tsx"
  ]
}
